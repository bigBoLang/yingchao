# 服务端口
PORT=8787
HOST=127.0.0.1

# 数据目录（SQLite、缓存等）
# DATA_DIR=./data

# 可选：服务端出站代理。公共搜索节点按出口 IP 限流时，可以让请求走本地代理。
# NO_PROXY 中的地址保持直连，避免影响本机的 PanSou（localhost:8888）。
# HTTPS_PROXY=http://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:10808
# NO_PROXY=127.0.0.1,localhost,::1

# PanSou 实例地址（默认渠道）
PANSOU_BASE_URL=http://localhost:8888

# 竹云盘搜公共节点（作为内置备用渠道）
ZHUYUN_BASE_URL=https://pan.zhuyunso.top
ENABLE_ZHUYUN=true

# 夸克 Cookie（可选）。不配置也能搜索与检测分享链接；
# 配置后才能解析网盘内的具体文件并生成可播放直链。
# 从浏览器登录 pan.quark.cn 后，复制请求头里的 Cookie。
QUARK_COOKIE=

# 缓存与巡检
SEARCH_CACHE_HOURS=12
METADATA_CACHE_HOURS=24
COLLECTION_REFRESH_HOURS=6
HOT_REFRESH_HOURS=6
VALIDATE_HOURS=3
HOT_REFRESH_LIMIT=12
VALIDATE_BATCH=60
SCHEDULER_ENABLED=true

# 用于签发播放代理链接
APP_SECRET=change-me-in-production
