# 服务端口
PORT=8787
# 0.0.0.0 允许局域网内其他设备访问（注意本服务没有登录鉴权）
HOST=0.0.0.0

# 数据目录（SQLite、缓存等）
# DATA_DIR=./data

# 可选：服务端出站代理。公共搜索节点按出口 IP 限流时，可以让请求走本地代理。
# 代理在线时优先走代理；代理软件退出后会自动直连，不会因为端口连不上而整体报错。
# 视频播放流量始终直连优先，不绕代理。
# HTTPS_PROXY=http://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:10808
# NO_PROXY=127.0.0.1,localhost,::1

# PanSou 实例地址（默认渠道）
PANSOU_BASE_URL=http://localhost:8888
# 启动影巢时自动拉起本机 PanSou（地址指向本机时才生效）
PANSOU_AUTOSTART=true
# 自定义 PanSou 可执行文件路径（不填则自动查找 pansou/ 或 macOS Application Support）
# PANSOU_BIN=/path/to/pansou
# 从公网域名访问、但客户端和服务器在同一家庭网络时，自动跳到局域网直连。
# 视频不再绕 Cloudflare；在域名后加 ?lan=0 可关闭（记一年）。多网卡可指定 LAN_IP。
AUTO_LAN_REDIRECT=true
# LAN_IP=192.168.1.10

# 竹云盘搜公共节点（作为内置备用渠道）
ZHUYUN_BASE_URL=https://pan.zhuyunso.top
ENABLE_ZHUYUN=true

# 夸克 Cookie（可选）。不配置也能搜索与检测分享链接；
# 配置后才能解析网盘内的具体文件并生成可播放直链。
# 从浏览器登录 pan.quark.cn 后，复制请求头里的 Cookie。
QUARK_COOKIE=

# 缓存与巡检
SEARCH_CACHE_HOURS=12
METADATA_CACHE_HOURS=24
COLLECTION_REFRESH_HOURS=6
HOT_REFRESH_HOURS=6
VALIDATE_HOURS=3
HOT_REFRESH_LIMIT=12
VALIDATE_BATCH=60
SCHEDULER_ENABLED=true

# 用于签发播放代理链接
APP_SECRET=change-me-in-production

# 可选访问密码（HTTP Basic）。两项都填后，除播放链接和豆瓣图片外都需要登录。
# 通过 Cloudflare Tunnel 或局域网把服务暴露出去时建议启用。
AUTH_USER=
AUTH_PASS=

# 默认禁止自定义渠道和视频直链访问内网地址；确实要访问局域网服务时设为 true。
ALLOW_PRIVATE_HOSTS=false

# 播放代理地址：tunnel=跟随访问域名（默认），direct=使用 PUBLIC_IP 直连
# 注意 Cloudflare 免费代理只转发 80/443，不适合带自定义端口直连。
PLAY_PROXY_MODE=tunnel
# PUBLIC_IP=yingchao.example.com
