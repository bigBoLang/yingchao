{
  "name": "yingchao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "影巢 · 豆瓣影视元数据 + 可插拔网盘资源检索",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup server/index.ts --format esm --platform node --target node22 --out-dir dist-server --clean --sourcemap --external better-sqlite3",
    "start": "node -r dotenv/config dist-server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
